{
  "name": "crypto-event-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notify": "scripts/notify.sh",
    "devsession": "scripts/devsession.sh",
    "ingest:dryrun": "tsx scripts/ingest-dryrun.ts",
    "ingest": "tsx scripts/ingest.ts",
    "enrich": "tsx scripts/enrich.ts",
    "preview": "tsx scripts/preview.ts",
    "backfill": "tsx scripts/backfill-candles.ts",
    "reactions": "tsx scripts/compute-reactions.ts",
    "expectations": "tsx scripts/compute-expectations.ts",
    "backfill:events": "tsx scripts/backfill-events.ts",
    "classify": "tsx scripts/classify.ts",
    "backfill:dvol": "tsx scripts/backfill-dvol.ts",
    "daily": "tsx scripts/daily-refresh.ts",
    "probe": "tsx scripts/probe-sources.ts",
    "unlocks:import": "tsx scripts/backfill-unlocks.ts",
    "unlocks:snapshot": "node scripts/fetch-defillama-browser.mjs",
    "worker:dev": "pnpm --filter @cee/worker run dev",
    "deploy": "pnpm --filter @cee/web build && pnpm --filter @cee/worker run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  }
}
