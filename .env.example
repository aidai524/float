# 复制为 .env 并填入真实值；.env 不会被提交

# ---- TypeSafe / Jev ----
TYPESAFE_API_KEY=

# ---- Supabase ----
SUPABASE_ACCESS_TOKEN=            # 管理 API（创建/管理项目）
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 仅服务端
SUPABASE_DB_URL=                  # 直连（可能 IPv6-only）
SUPABASE_DB_POOLER_URL=           # 迁移/脚本用这个

# ---- 数据源（可选，有免费档）----
COINGECKO_API_KEY=
COINMARKETCAL_API_KEY=
CRYPTOPANIC_API_KEY=
FRED_API_KEY=

# ---- Cloudflare（Phase 5 部署 / Cron）----
CLOUDFLARE_API_TOKEN=             # Workers Scripts:Edit + Account Settings:Read（+ Zone:Read / Workers Routes:Edit 用于自定义域）
CLOUDFLARE_ACCOUNT_ID=            # dashboard URL 里的 32 位 hex，或 wrangler whoami

# ---- Bark 通知 ----
BARK_DEVICE_KEY=
BARK_PUSH_URL=https://api.day.app/push

# ---- 开发会话守护 ----
DEVSESSION_DIM=0.0
DEVSESSION_IDLE_SECONDS=600
DEVSESSION_TICK_SECONDS=30
DEVSESSION_EXIT_AFTER_IDLE=1800
# 授权 macOS 自动化权限后可启用 Amphetamine
DEVSESSION_USE_AMPHETAMINE=0
