---
import Layout from "../layouts/Layout.astro";
import EventTable from "../components/EventTable";
import BaselinePanel from "../components/BaselinePanel.astro";
import { listEvents, listTypeStats } from "../lib/db";
import { eventTypeLabel, fmtTs, pct, pctClass } from "../lib/format";

const events = await listEvents(1000);
const stats = await listTypeStats(5);

const now = Date.now();
const upcoming = events
  .filter((e) => new Date(e.t0).getTime() > now)
  .sort((a, b) => new Date(a.t0).getTime() - new Date(b.t0).getTime())
  .slice(0, 10);

const measured = events.filter((e) => e.ret_1h != null).length;
const maxN = stats.reduce((a, s) => Math.max(a, s.n), 0);
const generatedAt = new Date().toISOString().replace("T", " ").slice(0, 19);

const cards = [
  { label: "事件总数", value: String(events.length) },
  { label: "已测量反应", value: String(measured) },
  { label: "未来 7 天", value: String(events.filter((e) => {
    const t = new Date(e.t0).getTime();
    return t > now && t < now + 7 * 86400000;
  }).length) },
  { label: "基准覆盖（≥5 样本）", value: String(stats.length) },
  { label: "最大样本 N", value: String(maxN) },
];

const daysUntil = (t: string) => {
  const d = Math.ceil((new Date(t).getTime() - now) / 86400000);
  return d <= 0 ? "今天" : d === 1 ? "明天" : `${d} 天后`;
};
---
<Layout subtitle={`数据更新于 ${generatedAt} UTC`}>
  <div class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {
      cards.map((c) => (
        <div class="rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-3">
          <div class="text-[20px] font-semibold leading-tight">{c.value}</div>
          <div class="mt-0.5 text-[11px] text-[var(--color-mut)]">{c.label}</div>
        </div>
      ))
    }
  </div>

  <div class="mb-5">
    <BaselinePanel stats={stats} generatedAt={generatedAt} />
  </div>

  <section class="mb-5 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <h2 class="m-0 text-[13px] font-semibold">接下来会发生什么</h2>
    <p class="mb-3 mt-1 text-[12px] text-[var(--color-mut)]">
      按时间排序的最近 {upcoming.length} 个未来事件。点标题进详情，点来源看原始公告。
    </p>
    {
      upcoming.length === 0 ? (
        <p class="text-[12px] text-[var(--color-mut)]">暂无已知的未来事件。</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[13px]">
            <thead>
              <tr class="text-[11px] uppercase tracking-wide text-[var(--color-mut)]">
                <th class="px-3 py-2 text-left">倒计时</th>
                <th class="px-3 py-2 text-left">时间 (UTC)</th>
                <th class="px-3 py-2 text-left">代币</th>
                <th class="px-3 py-2 text-left">类型</th>
                <th class="px-3 py-2 text-left">标题</th>
              </tr>
            </thead>
            <tbody>
              {upcoming.map((e) => (
                <tr class="border-b border-[var(--color-line)] hover:bg-[#16223c]">
                  <td class="mono px-3 py-2 text-amber-400">{daysUntil(e.t0)}</td>
                  <td class="mono px-3 py-2 text-[12px] text-[var(--color-mut)]">
                    {fmtTs(e.t0)}
                  </td>
                  <td class="px-3 py-2 font-semibold">
                    <a
                      href={`/event/${e.id}`}
                      class="no-underline text-[var(--color-fg)] hover:text-[var(--color-acc)]"
                    >
                      {e.token_symbol}
                    </a>
                  </td>
                  <td class="mono px-3 py-2 text-[12px]">{eventTypeLabel(e.event_type)}</td>
                  <td class="px-3 py-2">{e.title}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section class="rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <h2 class="m-0 mb-3 text-[13px] font-semibold">全部事件（{events.length} 条）</h2>
    <EventTable events={events} client:load />
  </section>
</Layout>
