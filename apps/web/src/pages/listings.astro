---
import Layout from "../layouts/Layout.astro";
import ListingStatsTable from "../components/ListingStatsTable.astro";
import {
  listListingCategoryStats,
  listListingFdvStats,
  listListingFormStats,
} from "../lib/db";
import { LISTING_FORM_LABEL, TOKEN_CATEGORY_LABEL } from "../lib/format";

const [forms, categories, fdv] = await Promise.all([
  listListingFormStats(5),
  listListingCategoryStats(5),
  listListingFdvStats(5),
]);

const FDV_ORDER = ["<1B", "1-5B", ">=5B"];
const FDV_LABEL: Record<string, string> = {
  "<1B": "< $1B",
  "1-5B": "$1B–5B",
  ">=5B": "≥ $5B",
};
const fdvKnown = [...fdv]
  .filter((d) => d.fdv_bucket !== "unknown")
  .sort((a, b) => FDV_ORDER.indexOf(a.fdv_bucket) - FDV_ORDER.indexOf(b.fdv_bucket));
const fdvUnknown = fdv.find((d) => d.fdv_bucket === "unknown");

const formRows = forms.map((f) => ({
  ...f,
  label: LISTING_FORM_LABEL[f.listing_form] ?? f.listing_form,
}));
const categoryRows = categories.map((c) => ({
  ...c,
  label: TOKEN_CATEGORY_LABEL[c.token_category] ?? c.token_category,
}));
const fdvRows = fdvKnown.map((d) => ({ ...d, label: FDV_LABEL[d.fdv_bucket] ?? d.fdv_bucket }));

const total = forms.reduce((a, f) => a + f.n, 0);
const pct = (v: number | null, digits = 2) =>
  v == null ? "—" : `${v >= 0 ? "+" : ""}${(v * 100).toFixed(digits)}%`;
const cls = (v: number | null) =>
  v == null ? "text-[var(--color-mut)]" : v > 0 ? "text-emerald-400" : "text-rose-400";
const headline = forms.find((f) => f.listing_form === "new_listing") ?? forms[0];
---

<Layout title="上币反应" subtitle="上币形式、代币类别与规模如何影响价格反应">
  <h1 class="m-0 mb-1 text-[18px] font-semibold">上币反应研究</h1>
  <p class="mb-4 mt-0 text-[13px] text-[var(--color-mut)]">
    交易所公告后价格到底怎么走？这一页把 <strong>上币形式</strong>（现货新币 / 合约 / Seed Tag /
    RWA）与 <strong>代币类别</strong> 拆开，给出中位与 25–75 分位区间，而不是一个笼统的"利好"。
  </p>

  {
    headline && (
      <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
        <div class="text-[12px] text-[var(--color-mut)]">
          现货新币公告后（{headline.n} 条，Binance）
        </div>
        <div class="mt-1 flex items-baseline gap-4 flex-wrap">
          <div>
            <span class={`text-[28px] font-semibold tabular-nums ${cls(headline.median_1h)}`}>
              {pct(headline.median_1h)}
            </span>
            <span class="ml-1 text-[12px] text-[var(--color-mut)]">1h 中位</span>
          </div>
          <div>
            <span class={`text-[28px] font-semibold tabular-nums ${cls(headline.median_4h)}`}>
              {pct(headline.median_4h)}
            </span>
            <span class="ml-1 text-[12px] text-[var(--color-mut)]">4h 中位</span>
          </div>
          <div>
            <span class={`text-[28px] font-semibold tabular-nums ${cls(headline.median_24h)}`}>
              {pct(headline.median_24h)}
            </span>
            <span class="ml-1 text-[12px] text-[var(--color-mut)]">24h 中位</span>
          </div>
        </div>
        <div class="mt-1 text-[11px] text-[var(--color-mut)]">
          4h 25–75 分位 {pct(headline.p25_4h, 1)} ~ {pct(headline.p75_4h, 1)} ·
          24h 上涨占比 {headline.pos_24h == null ? "—" : `${(headline.pos_24h * 100).toFixed(0)}%`}
          （N={headline.n_24h}）· 本页共 {total} 条上币事件
        </div>
      </section>
    )
  }

  <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <div class="mb-2 font-semibold">按上币形式</div>
    <ListingStatsTable rows={formRows} labelHeader="形式" />
  </section>

  <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <div class="mb-2 font-semibold">按代币类别</div>
    <ListingStatsTable rows={categoryRows} labelHeader="类别" />
  </section>

  <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <div class="mb-2 font-semibold">按 FDV 档（覆盖受限）</div>
    <p class="mb-2 mt-0 text-[11px] text-[var(--color-mut)]">
      FDV ≈ 上币时基准价 × 最大供应；最大供应仅能从 DefiLlama
      解锁数据推导（覆盖约 1/3 标的）。缺口不猜测，单列 unknown。
    </p>
    <ListingStatsTable rows={fdvRows} labelHeader="FDV" />
    {fdvUnknown && (
      <p class="mb-0 mt-2 text-[11px] text-[var(--color-mut)]">
        unknown：N={fdvUnknown.n}（不做推断，仅供参考）
      </p>
    )}
  </section>

  <section
    class="rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4 text-[12px] text-[var(--color-mut)]"
  >
    <div class="mb-1 font-semibold text-[var(--color-fg)]">口径</div>
    <p class="m-0">
      事件：Binance 上币公告（catalog 48，经规则排除/归类）；T0 = 公告时间，若公告早于开盘则从首个成交时刻起算（
      <code>base_after_t0</code>）· 反应为原始收益（不剔 BTC，上币常伴随大幅重定价）· 形式由标题规则判定（
      <code>public.listing_form</code>，可复算）· 收益窗口 1h / 4h / 24h，最长回撤取 [T0, T0+4h] ·
      历史分布不代表未来，仅供研究，非投资建议。
    </p>
  </section>
</Layout>
