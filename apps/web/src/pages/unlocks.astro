---
import Layout from "../layouts/Layout.astro";
import {
  getUnlockSlope,
  listUnlockCategoryStats,
  listUnlockDilutionStats,
} from "../lib/db";

const [slope, dilution, categories] = await Promise.all([
  getUnlockSlope(),
  listUnlockDilutionStats(),
  listUnlockCategoryStats(5),
]);

const BUCKET_ORDER = ["0.1-0.3%", "0.3-1%", "1-3%", "3-10%", ">=10%"];
const dilutionSorted = [...dilution].sort(
  (a, b) => BUCKET_ORDER.indexOf(a.bucket) - BUCKET_ORDER.indexOf(b.bucket),
);

const pctSigned = (v: number | null, digits = 2) =>
  v == null ? "—" : `${v >= 0 ? "+" : ""}${(v * 100).toFixed(digits)}%`;
const pctPlain = (v: number | null, digits = 2) =>
  v == null ? "—" : `${(v * 100).toFixed(digits)}%`;
const cls = (v: number | null) =>
  v == null
    ? "text-[var(--color-mut)]"
    : v > 0
      ? "text-emerald-400"
      : v < 0
        ? "text-rose-400"
        : "text-[var(--color-mut)]";
const num = (v: number | null, digits = 2) => (v == null ? "—" : v.toFixed(digits));

const CATEGORY_LABEL: Record<string, string> = {
  insiders: "内部人（团队/基金会）",
  privateSale: "私募",
  publicSale: "公募",
  community: "社区",
  ecosystem: "生态",
  staking: "质押",
  farming: "农场激励",
  airdrop: "空投",
  noncirculating: "未流通",
  liquidity: "流动性",
  burned: "销毁",
  Uncategorized: "未分类",
  unknown: "未知",
};
---

<Layout title="解锁反应" subtitle="稀释规模与接收方如何影响价格">
  <h1 class="m-0 mb-1 text-[18px] font-semibold">解锁反应研究</h1>
  <p class="mb-4 mt-0 text-[13px] text-[var(--color-mut)]">
    同一件事——代币解锁——反应并不一样。这一页把 <strong>稀释规模</strong>（占供应比例）和
    <strong>接收方</strong>（团队 / 私募 / 社区 / 生态…）拆开，看历史上不一样在哪。
  </p>

  {
    slope && slope.n > 0 && (
      <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
        <div class="text-[12px] text-[var(--color-mut)]">
          每 1% 供应稀释对应的 4h 收益（归一化斜率）
        </div>
        <div class={`mt-1 text-[28px] font-semibold tabular-nums ${cls(slope.slope_4h_per_pct)}`}>
          {pctSigned(slope.slope_4h_per_pct)}
        </div>
        <div class="mt-1 text-[12px] text-[var(--color-mut)]">
          N = {slope.n} · R² = {num(slope.r2)} · 样本中位稀释 {pctPlain(slope.median_pct)} ·
          样本中位 4h 反应 {pctSigned(slope.median_ret_4h)}
        </div>
      </section>
    )
  }

  <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <div class="mb-2 font-semibold">按稀释规模</div>
    <table class="w-full text-[12px] tabular-nums">
      <thead class="text-[var(--color-mut)]">
        <tr class="text-left">
          <th class="py-1 font-normal">稀释</th>
          <th class="py-1 text-right font-normal">N</th>
          <th class="py-1 text-right font-normal">1h 中位</th>
          <th class="py-1 text-right font-normal">4h 中位</th>
          <th class="py-1 text-right font-normal">24h 中位</th>
          <th class="py-1 text-right font-normal">最大回撤中位</th>
          <th class="py-1 text-right font-normal">4h 上涨占比</th>
        </tr>
      </thead>
      <tbody>
        {
          dilutionSorted.map((d) => (
            <tr class="border-t border-[var(--color-line)]">
              <td class="py-1">{d.bucket}</td>
              <td class="py-1 text-right">{d.n}</td>
              <td class={`py-1 text-right ${cls(d.median_ret_1h)}`}>{pctSigned(d.median_ret_1h)}</td>
              <td class={`py-1 text-right ${cls(d.median_ret_4h)}`}>{pctSigned(d.median_ret_4h)}</td>
              <td class={`py-1 text-right ${cls(d.median_ret_24h)}`}>
                {pctSigned(d.median_ret_24h)}
              </td>
              <td class={`py-1 text-right ${cls(d.median_max_dd)}`}>{pctSigned(d.median_max_dd)}</td>
              <td class="py-1 text-right">{pctPlain(d.pos_4h, 0)}</td>
            </tr>
          ))
        }
        {
          dilutionSorted.length === 0 && (
            <tr>
              <td colspan="7" class="py-2 text-[var(--color-mut)]">
                样本积累中
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </section>

  <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <div class="mb-2 font-semibold">按接收方</div>
    <table class="w-full text-[12px] tabular-nums">
      <thead class="text-[var(--color-mut)]">
        <tr class="text-left">
          <th class="py-1 font-normal">接收方</th>
          <th class="py-1 text-right font-normal">N</th>
          <th class="py-1 text-right font-normal">平均稀释</th>
          <th class="py-1 text-right font-normal">1h 中位</th>
          <th class="py-1 text-right font-normal">4h 中位</th>
          <th class="py-1 text-right font-normal">4h 25–75 分位</th>
          <th class="py-1 text-right font-normal">最大回撤中位</th>
        </tr>
      </thead>
      <tbody>
        {
          categories.map((c) => (
            <tr class="border-t border-[var(--color-line)]">
              <td class="py-1">{CATEGORY_LABEL[c.category] ?? c.category}</td>
              <td class="py-1 text-right">{c.n}</td>
              <td class="py-1 text-right">{pctPlain(c.avg_pct)}</td>
              <td class={`py-1 text-right ${cls(c.median_ret_1h)}`}>{pctSigned(c.median_ret_1h)}</td>
              <td class={`py-1 text-right ${cls(c.median_ret_4h)}`}>{pctSigned(c.median_ret_4h)}</td>
              <td class="py-1 text-right">
                {pctSigned(c.p25_ret_4h, 1)} ~ {pctSigned(c.p75_ret_4h, 1)}
              </td>
              <td class={`py-1 text-right ${cls(c.median_max_dd)}`}>{pctSigned(c.median_max_dd)}</td>
            </tr>
          ))
        }
        {
          categories.length === 0 && (
            <tr>
              <td colspan="7" class="py-2 text-[var(--color-mut)]">
                样本积累中
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </section>

  <section
    class="rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4 text-[12px] text-[var(--color-mut)]"
  >
    <div class="mb-1 font-semibold text-[var(--color-fg)]">口径</div>
    <p class="m-0">
      仅 cliff 解锁 · 稀释占供应 ≥ 0.5% · 有 Binance 交易对且流动性达标 · 反应口径 v1 ·
      数据源 DefiLlama（历史）+ Binance（价格）。历史分布不代表未来，仅供研究，非投资建议。
    </p>
  </section>
</Layout>
