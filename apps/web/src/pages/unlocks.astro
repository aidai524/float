---
import Layout from "../layouts/Layout.astro";
import {
  getUnlockSlopeV2,
  listUnlockCategoryStatsV2,
  listUnlockFloatStats,
} from "../lib/db";

const [slope, floatStats, categories] = await Promise.all([
  getUnlockSlopeV2(),
  listUnlockFloatStats(),
  listUnlockCategoryStatsV2(5),
]);

const BUCKET_ORDER = ["0.5-1%", "1-2%", "2-5%", "5-10%", ">=10%"];
const floatSorted = [...floatStats].sort(
  (a, b) => BUCKET_ORDER.indexOf(a.bucket) - BUCKET_ORDER.indexOf(b.bucket),
);

const pctSigned = (v: number | null, digits = 2) =>
  v == null ? "—" : `${v >= 0 ? "+" : ""}${(v * 100).toFixed(digits)}%`;
const pctPlain = (v: number | null, digits = 2) =>
  v == null ? "—" : `${(v * 100).toFixed(digits)}%`;
const cls = (v: number | null) =>
  v == null
    ? "text-[var(--color-mut)]"
    : v > 0
      ? "text-emerald-400"
      : v < 0
        ? "text-rose-400"
        : "text-[var(--color-mut)]";
const num = (v: number | null, digits = 2) => (v == null ? "—" : v.toFixed(digits));
const zFmt = (v: number | null) =>
  v == null ? "—" : `${v > 0 ? "+" : ""}${v.toFixed(2)}σ`;
const zCls = (v: number | null) =>
  v == null
    ? "text-[var(--color-mut)]"
    : v <= -1
      ? "text-rose-400"
      : v >= 1
        ? "text-emerald-400"
        : "text-[var(--color-mut)]";

const CATEGORY_LABEL: Record<string, string> = {
  insiders: "内部人（团队/基金会）",
  privateSale: "私募",
  publicSale: "公募",
  community: "社区",
  ecosystem: "生态",
  staking: "质押",
  farming: "农场激励",
  airdrop: "空投",
  noncirculating: "未流通",
  liquidity: "流动性",
  burned: "销毁",
  Uncategorized: "未分类",
  unknown: "未知",
};
---

<Layout title="解锁反应" subtitle="float 稀释与接收方如何影响价格（已剔除 BTC）">
  <h1 class="m-0 mb-1 text-[18px] font-semibold">解锁反应研究</h1>
  <p class="mb-4 mt-0 text-[13px] text-[var(--color-mut)]">
    同一件事——代币解锁——反应并不一样。这一页把 <strong>float 稀释</strong>（占当前流通量）和
    <strong>接收方</strong>（团队 / 私募 / 社区 / 生态…）拆开，并剔除 BTC 同期涨跌，
    看历史上不一样在哪。
  </p>

  {
    slope && slope.n > 0 && (
      <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
        <div class="text-[12px] text-[var(--color-mut)]">
          每 1% float 稀释对应的 4h 收益（已剔除 BTC）
        </div>
        <div
          class={`mt-1 text-[28px] font-semibold tabular-nums ${cls(slope.slope_excess_4h_per_pct)}`}
        >
          {pctSigned(slope.slope_excess_4h_per_pct)}
        </div>
        <div class="mt-1 text-[12px] text-[var(--color-mut)]">
          N = {slope.n}（有调整值 {slope.n_excess}） · R² = {num(slope.r2)} · 样本中位稀释{" "}
          {slope.median_float_pct == null ? "—" : `${slope.median_float_pct.toFixed(2)}%`} ·
          中位调整后 4h {pctSigned(slope.median_excess_4h)}
        </div>
        <div class="mt-1 text-[11px] text-[var(--color-mut)]">
          对照：不剔除 BTC 的原始斜率 {pctSigned(slope.slope_ret_4h_per_pct)}（R² ={" "}
          {num(slope.r2_ret)}） · 事前 3 天斜率 {pctSigned(slope.slope_pre_excess_72h_per_pct)}
          （R² = {num(slope.r2_pre_excess_72h)}） · 解锁后 7 天斜率{" "}
          {pctSigned(slope.slope_excess_168h_per_pct)}（R² = {num(slope.r2_excess_168h)}）
        </div>
      </section>
    )
  }

  <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <div class="mb-2 font-semibold">按 float 稀释（占流通量）</div>
    <p class="mb-2 mt-0 text-[11px] text-[var(--color-mut)]">
      「调整后」= 代币收益 − BTC 同期收益；σ = 相对事件前 30 天日波动的标准化偏离。
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-[12px] tabular-nums">
        <thead class="text-[var(--color-mut)]">
          <tr class="text-left">
            <th class="py-1 font-normal">稀释</th>
            <th class="py-1 text-right font-normal">N（有调整）</th>
            <th class="py-1 text-right font-normal">平均 float</th>
            <th class="py-1 text-right font-normal">前 3 天</th>
            <th class="py-1 text-right font-normal">4h 调整后</th>
            <th class="py-1 text-right font-normal">4h 25–75</th>
            <th class="py-1 text-right font-normal">24h 调整后</th>
            <th class="py-1 text-right font-normal">7 天调整后</th>
            <th class="py-1 text-right font-normal">z 中位</th>
            <th class="py-1 text-right font-normal">4h 上涨占比</th>
          </tr>
        </thead>
        <tbody>
          {
            floatSorted.map((d) => (
              <tr class="border-t border-[var(--color-line)]">
                <td class="py-1">{d.bucket}</td>
                <td class="py-1 text-right">
                  {d.n_excess} / {d.n}
                </td>
                <td class="py-1 text-right">{pctPlain(d.avg_float_pct)}</td>
                <td class={`py-1 text-right ${cls(d.median_pre_excess_72h)}`}>
                  {pctSigned(d.median_pre_excess_72h)}
                </td>
                <td class={`py-1 text-right font-semibold ${cls(d.median_excess_4h)}`}>
                  {pctSigned(d.median_excess_4h)}
                </td>
                <td class="py-1 text-right text-[var(--color-mut)]">
                  {pctSigned(d.p25_excess_4h, 1)} ~ {pctSigned(d.p75_excess_4h, 1)}
                </td>
                <td class={`py-1 text-right ${cls(d.median_excess_24h)}`}>
                  {pctSigned(d.median_excess_24h)}
                </td>
                <td class={`py-1 text-right ${cls(d.median_excess_168h)}`}>
                  {pctSigned(d.median_excess_168h)}
                </td>
                <td class={`py-1 text-right ${zCls(d.median_z_4h)}`}>{zFmt(d.median_z_4h)}</td>
                <td class="py-1 text-right">{pctPlain(d.pos_excess_4h, 0)}</td>
              </tr>
            ))
          }
          {
            floatSorted.length === 0 && (
              <tr>
                <td colspan="10" class="py-2 text-[var(--color-mut)]">
                  样本积累中
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <div class="mb-2 font-semibold">按接收方</div>
    <div class="overflow-x-auto">
      <table class="w-full text-[12px] tabular-nums">
        <thead class="text-[var(--color-mut)]">
          <tr class="text-left">
            <th class="py-1 font-normal">接收方</th>
            <th class="py-1 text-right font-normal">N（有调整）</th>
            <th class="py-1 text-right font-normal">平均 float</th>
            <th class="py-1 text-right font-normal">前 3 天</th>
            <th class="py-1 text-right font-normal">4h 调整后</th>
            <th class="py-1 text-right font-normal">4h 25–75</th>
            <th class="py-1 text-right font-normal">24h 调整后</th>
            <th class="py-1 text-right font-normal">7 天调整后</th>
            <th class="py-1 text-right font-normal">z 中位</th>
          </tr>
        </thead>
        <tbody>
          {
            categories.map((c) => (
              <tr class="border-t border-[var(--color-line)]">
                <td class="py-1">{CATEGORY_LABEL[c.category] ?? c.category}</td>
                <td class="py-1 text-right">
                  {c.n_excess} / {c.n}
                </td>
                <td class="py-1 text-right">{pctPlain(c.avg_float_pct)}</td>
                <td class={`py-1 text-right ${cls(c.median_pre_excess_72h)}`}>
                  {pctSigned(c.median_pre_excess_72h)}
                </td>
                <td class={`py-1 text-right font-semibold ${cls(c.median_excess_4h)}`}>
                  {pctSigned(c.median_excess_4h)}
                </td>
                <td class="py-1 text-right text-[var(--color-mut)]">
                  {pctSigned(c.p25_excess_4h, 1)} ~ {pctSigned(c.p75_excess_4h, 1)}
                </td>
                <td class={`py-1 text-right ${cls(c.median_excess_24h)}`}>
                  {pctSigned(c.median_excess_24h)}
                </td>
                <td class={`py-1 text-right ${cls(c.median_excess_168h)}`}>
                  {pctSigned(c.median_excess_168h)}
                </td>
                <td class={`py-1 text-right ${zCls(c.median_z_4h)}`}>{zFmt(c.median_z_4h)}</td>
              </tr>
            ))
          }
          {
            categories.length === 0 && (
              <tr>
                <td colspan="9" class="py-2 text-[var(--color-mut)]">
                  样本积累中
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  <section
    class="rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4 text-[12px] text-[var(--color-mut)]"
  >
    <div class="mb-1 font-semibold text-[var(--color-fg)]">口径（v2）</div>
    <p class="m-0">
      仅 cliff 解锁 · float 稀释 ≥ 0.5%（占当前流通量；缺失时回退占最大供应）· 有 Binance
      交易对且流动性达标 · <strong>市场调整</strong> = 代币收益 − BTC 同期收益（一阶，β=1）·
      <strong>z</strong> = 调整后收益 /（事件前 30 天日波动 × √窗口）· 反应口径 v1 · 数据源
      DefiLlama（解锁历史）+ Binance（价格与 BTC 基准）。历史分布不代表未来，仅供研究，非投资建议。
    </p>
  </section>
</Layout>
