---
import Layout from "../../layouts/Layout.astro";
import PriceChart from "../../components/PriceChart";
import { getBaseline, getEventCandles, getEventExpectation, listEvents } from "../../lib/db";
import {
  ASSET_COLOR,
  eventFacts,
  eventTypeLabel,
  fmtPrice,
  fmtTs,
  fmtUsd,
  hostOf,
  liquidityLabel,
  pct,
  pctClass,
} from "../../lib/format";

export async function getStaticPaths() {
  const events = await listEvents(1000);
  return events.map((e) => ({ params: { id: String(e.id) }, props: { event: e } }));
}

const { event } = Astro.props;
const e = event;
const baseline = await getBaseline(e.id);
const expectation = await getEventExpectation(e.id);

const { interval, candles } = await getEventCandles(e.token_symbol, e.t0);
const t = new Date(e.t0).getTime();
const markers = candles.length ? [{ t, label: "T0" }] : [];
const facts = eventFacts(e);
const liq = liquidityLabel(e.liquidity_ok);

const horizons: Array<{ label: string; key: keyof typeof e; pctKey: string }> = [
  { label: "5m", key: "ret_5m", pctKey: "pct_5m" },
  { label: "15m", key: "ret_15m", pctKey: "pct_15m" },
  { label: "1h", key: "ret_1h", pctKey: "pct_1h" },
  { label: "4h", key: "ret_4h", pctKey: "pct_4h" },
  { label: "24h", key: "ret_24h", pctKey: "pct_24h" },
];

const percentileLabel = (v: unknown): string | null => {
  if (v == null) return null;
  const n = Number(v);
  return `同类历史 ${Math.round(n * 100)} 分位`;
};

/** 市场调整后的读数（z = 相对自身事前波动的 sigma 数） */
const zReading = (z: number | null): string => {
  if (z == null) return "—";
  if (z <= -2) return "显著弱于自身常态";
  if (z <= -1) return "偏弱";
  if (z >= 2) return "显著强于自身常态";
  if (z >= 1) return "偏强";
  return "正常范围内";
};

const excessRows = expectation
  ? [
      {
        label: "前 3 天（事前）",
        ret: expectation.pre_ret_72h,
        bench:
          expectation.pre_ret_72h != null && expectation.pre_excess_72h != null
            ? expectation.pre_ret_72h - expectation.pre_excess_72h
            : null,
        excess: expectation.pre_excess_72h,
        z: null,
      },
      {
        label: "1h",
        ret: e.ret_1h,
        bench: expectation.bench_ret_1h,
        excess: expectation.excess_ret_1h,
        z: expectation.z_1h,
      },
      {
        label: "4h",
        ret: e.ret_4h,
        bench: expectation.bench_ret_4h,
        excess: expectation.excess_ret_4h,
        z: expectation.z_4h,
      },
      {
        label: "24h",
        ret: e.ret_24h,
        bench: expectation.bench_ret_24h,
        excess: expectation.excess_ret_24h,
        z: expectation.z_24h,
      },
      {
        label: "7 天",
        ret: expectation.ret_168h,
        bench:
          expectation.ret_168h != null && expectation.excess_ret_168h != null
            ? expectation.ret_168h - expectation.excess_ret_168h
            : null,
        excess: expectation.excess_ret_168h,
        z: expectation.z_168h,
      },
    ]
  : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: `${e.token_symbol} ${eventTypeLabel(e.event_type)}`,
  startDate: e.t0,
  description: e.title ?? undefined,
};
---
<Layout title={`${e.token_symbol} · ${eventTypeLabel(e.event_type)}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <a href="/calendar" class="text-[12px] no-underline text-[var(--color-mut)]">← 返回日历</a>

  <header class="mt-2 mb-4">
    <div class="flex items-center gap-3 flex-wrap">
      <h1 class="m-0 text-[22px] font-semibold">
        {e.token_symbol}
        <span class="text-[15px] font-normal text-[var(--color-mut)]">
          · {eventTypeLabel(e.event_type)}
        </span>
      </h1>
      <span
        class="rounded-full px-2 py-[2px] text-[11px] font-semibold text-white"
        style={`background:${ASSET_COLOR[e.asset_class] ?? "#64748b"}`}
      >
        {e.asset_class}
      </span>
      {e.base_after_t0 && (
        <span class="rounded bg-amber-500/15 px-2 py-[2px] text-[11px] text-amber-400">
          T0 时尚无市场数据，基准取自 T0 之后
        </span>
      )}
    </div>
    <p class="mt-1 mb-0 text-[14px]">{e.title}</p>
    {e.source_url && (
      <a href={e.source_url} target="_blank" rel="noopener" class="text-[12px]">
        原始公告：{hostOf(e.source_url)} ↗
      </a>
    )}
  </header>

  <section class="mb-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {
      facts.map((f) => (
        <div class="rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-3">
          <div class="text-[11px] text-[var(--color-mut)]">{f.label}</div>
          <div class="mt-0.5 text-[14px] font-medium">{f.value}</div>
        </div>
      ))
    }
  </section>

  <section class="mb-5 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <h2 class="m-0 text-[13px] font-semibold">测量反应</h2>
    <p class="mb-3 mt-1 text-[12px] text-[var(--color-mut)]">
      口径 methodology {e.methodology_version} · 基准价 {fmtPrice(e.base_price)}（
      {fmtTs(e.base_ts)}）· 价格源 {e.price_source ?? "—"} · 流动性 <span class={liq.cls}>{liq.text}</span>
      {e.base_after_t0 && <span class="text-amber-400">· 从首个成交时刻起算</span>}
    </p>
    <div class="grid grid-cols-3 gap-3 sm:grid-cols-5">
      {
        horizons.map((h) => (
          <div class="rounded border border-[var(--color-line)] p-3 text-center">
            <div class="text-[11px] text-[var(--color-mut)]">{h.label}</div>
            <div class={`mono mt-1 text-[16px] font-semibold ${pctClass(e[h.key] as number | null)}`}>
              {pct(e[h.key] as number | null)}
            </div>
            {baseline?.[h.pctKey] != null && (
              <div class="mt-1 text-[10px] text-[var(--color-mut)]">
                {percentileLabel(baseline[h.pctKey])}
              </div>
            )}
          </div>
        ))
      }
    </div>
    <div class="mt-3 grid grid-cols-2 gap-3 text-[12px] sm:grid-cols-4">
      <div>
        <span class="text-[var(--color-mut)]">量比：</span>
        {e.vol_ratio == null ? "—" : `${e.vol_ratio.toFixed(2)}×`}
      </div>
      <div>
        <span class="text-[var(--color-mut)]">最大冲高：</span>
        <span class={pctClass(e.max_favorable)}>{pct(e.max_favorable)}</span>
      </div>
      <div>
        <span class="text-[var(--color-mut)]">最大回撤：</span>
        <span class={pctClass(e.max_drawdown)}>{pct(e.max_drawdown)}</span>
      </div>
      <div>
        <span class="text-[var(--color-mut)]">规模：</span>{fmtUsd(e.magnitude_usd)}
      </div>
    </div>
  </section>

  {
    expectation && excessRows.some((r) => r.excess != null) && (
      <section class="mb-5 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
        <h2 class="m-0 text-[13px] font-semibold">市场调整（vs BTC）</h2>
        <p class="mb-3 mt-1 text-[12px] text-[var(--color-mut)]">
          先剔除 BTC 同期涨跌（一阶，β=1），再按事件前 30 天日波动标准化：z = 超常收益 /
          （日波动 × √窗口）。
        </p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[13px]">
            <thead>
              <tr class="text-[11px] uppercase tracking-wide text-[var(--color-mut)]">
                <th class="px-3 py-2 text-left">窗口</th>
                <th class="px-3 py-2 text-right">原始收益</th>
                <th class="px-3 py-2 text-right">BTC 同期</th>
                <th class="px-3 py-2 text-right">超常收益</th>
                <th class="px-3 py-2 text-right">z</th>
                <th class="px-3 py-2 text-left">读数</th>
              </tr>
            </thead>
            <tbody>
              {excessRows.map((r) => (
                <tr class="border-b border-[var(--color-line)]">
                  <td class="px-3 py-2">{r.label}</td>
                  <td class={`mono px-3 py-2 text-right ${pctClass(r.ret)}`}>{pct(r.ret)}</td>
                  <td class="mono px-3 py-2 text-right text-[var(--color-mut)]">
                    {pct(r.bench)}
                  </td>
                  <td class={`mono px-3 py-2 text-right font-semibold ${pctClass(r.excess)}`}>
                    {pct(r.excess)}
                  </td>
                  <td
                    class={`mono px-3 py-2 text-right ${r.z != null && r.z <= -1 ? "text-rose-400" : r.z != null && r.z >= 1 ? "text-emerald-400" : "text-[var(--color-mut)]"}`}
                  >
                    {r.z == null ? "—" : `${r.z > 0 ? "+" : ""}${r.z.toFixed(2)}σ`}
                  </td>
                  <td class="px-3 py-2 text-[12px] text-[var(--color-mut)]">
                    {zReading(r.z)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {
          expectation && (expectation.abn_pre_72h != null || expectation.abn_168h != null) && (
            <p class="mb-0 mt-3 text-[12px] text-[var(--color-mut)]">
              安慰剂对照（同一代币非事件窗口 T0−21d / 14d）：前 3 天净{" "}
              <span class={pctClass(expectation.abn_pre_72h)}>
                {pct(expectation.abn_pre_72h)}
              </span>{" "}
              · 7 天净 <span class={pctClass(expectation.abn_168h)}>
                {pct(expectation.abn_168h)}
              </span>
            </p>
          )
        }
      </section>
    )
  }

  {
    e.implied_move_1h != null && (
      <section class="mb-5 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
        <h2 class="m-0 text-[13px] font-semibold">预期 vs 实际</h2>
        <p class="mb-3 mt-1 text-[12px] text-[var(--color-mut)]">
          隐含幅度 = 事件前 DVOL（Deribit 年化隐含波动率）× √窗口；惊讶度 = 实际 / 隐含。
        </p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[13px]">
            <thead>
              <tr class="text-[11px] uppercase tracking-wide text-[var(--color-mut)]">
                <th class="px-3 py-2 text-left">窗口</th>
                <th class="px-3 py-2 text-right">隐含幅度</th>
                <th class="px-3 py-2 text-right">实际最大偏离</th>
                <th class="px-3 py-2 text-right">惊讶度</th>
                <th class="px-3 py-2 text-left">读数</th>
              </tr>
            </thead>
            <tbody>
              {[
                { label: "1h", imp: e.implied_move_1h, sur: e.surprise_1h },
                { label: "4h", imp: e.implied_move_4h, sur: e.surprise_4h },
                { label: "24h", imp: e.implied_move_24h, sur: e.surprise_24h },
              ].map((r) => (
                <tr class="border-b border-[var(--color-line)]">
                  <td class="px-3 py-2">{r.label}</td>
                  <td class="mono px-3 py-2 text-right text-[var(--color-mut)]">
                    {r.imp == null ? "—" : `${(r.imp * 100).toFixed(2)}%`}
                  </td>
                  <td class="mono px-3 py-2 text-right">
                    {r.sur == null || r.imp == null
                      ? "—"
                      : `${(r.sur * r.imp * 100).toFixed(2)}%`}
                  </td>
                  <td
                    class={`mono px-3 py-2 text-right font-semibold ${r.sur != null && r.sur > 1 ? "text-amber-400" : "text-emerald-400"}`}
                  >
                    {r.sur == null ? "—" : `${r.sur.toFixed(2)}×`}
                  </td>
                  <td class="px-3 py-2 text-[12px] text-[var(--color-mut)]">
                    {r.sur == null
                      ? "—"
                      : r.sur > 1.3
                        ? "远超市场定价"
                        : r.sur > 1.0
                          ? "略超预期"
                          : "已在预期内"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <section class="mb-5 rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
    <h2 class="m-0 mb-3 text-[13px] font-semibold">
      价格（{interval}，T0 附近）
    </h2>
    {
      candles.length ? (
        <PriceChart candles={candles} markers={markers} client:load />
      ) : (
        <p class="text-[12px] text-[var(--color-mut)]">暂无该代币的价格数据</p>
      )
    }
  </section>

  <section class="rounded-lg border border-[var(--color-line)] bg-[var(--color-panel)] p-4 text-[12px] text-[var(--color-mut)]">
    <p class="mt-0">
      数据源：{e.source_count} 个印证 · 事件置信度 {e.confidence.toFixed(2)} · 记录更新于 {fmtTs(e.updated_at)}
    </p>
    <p class="mb-0">
      统计基于历史市场数据，非 AI 生成。事件类型由 Jev（System One）判定，数字全部由代码计算。
    </p>
  </section>
</Layout>
