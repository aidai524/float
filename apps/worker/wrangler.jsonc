{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "float",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 静态资源 = Astro 构建产物；/api/* 优先交给 Worker
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // API 用量计量（free 档可用）：key/anon × 路径 × 计数
  "analytics_engine_datasets": [{ "binding": "API_METER", "dataset": "float_api" }],
  // USDC 订阅（收款地址 CRYPTO_PAY_TO 用 wrangler secret 注入）
  "vars": { "CRYPTO_CHAIN": "base", "PRO_PRICE_USD": "19", "PRO_PERIOD_DAYS": "30" },
  // 数据集导出（CSV）：由部署工作流写入，Worker 只读提供
  "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "float-exports" }],
  // 每日刷新（解锁 / 公告 / 反应）。先占位，迁移完成后在此触发。
  "triggers": {
    "crons": ["10 1 * * *"],
  },
}
